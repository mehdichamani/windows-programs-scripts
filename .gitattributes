# Set default behavior for line endings
* text=auto eol=crlf

# Ensure Windows batch files and PowerShell scripts ALWAYS check out with CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.reg text eol=crlf
*.vbs text eol=crlf
*.ini text eol=crlf
*.xml text eol=crlf

# Shell scripts and documentation
*.sh text eol=lf
*.md text
*.txt text
.gitignore text
.gitattributes text
